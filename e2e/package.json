{
  "name": "@densio/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "synthetic:production": "tsx deployed/production.ts",
    "synthetic:staging": "tsx deployed/staging.ts",
    "test": "vitest run --config vitest.config.ts",
