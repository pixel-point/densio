{
  "name": "@densio/workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "e2e",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run typecheck test && pnpm lint && pnpm format:check",
    "dev": "turbo run dev --filter=@densio/api",
    "format": "oxfmt --disable-nested-config --write .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config . --fix",
    "synthetic:production": "pnpm build && pnpm --filter @densio/e2e synthetic:production",
    "synthetic:staging": "pnpm build && pnpm --filter @densio/e2e synthetic:staging",
    "test": "turbo run test",
    "test:e2e": "turbo run test --filter=@densio/e2e",
    "typecheck": "turbo run typecheck",
    "typecheck:e2e": "turbo run typecheck --filter=@densio/e2e",
    "test:fast": "turbo run test:fast",
    "test:media": "turbo run test:media"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.18.0",
    "@typescript/native-preview": "^7.0.0-dev.20260703.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.7.0",
    "tsx": "^4.21.0",
    "turbo": "^2.8.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.7.0"
}
