{
  "name": "@densio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin": "tsx src/admin.ts",
    "build": "esbuild src/server.ts src/admin.ts --bundle --platform=node --format=esm --loader:.md=text --outdir=dist --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);'",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit --project tsconfig.json --pretty false",
    "test:fast": "vitest run --project fast",
    "test:media": "vitest run --project media"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@densio/shared": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "@hono/standard-validator": "^0.4.0",
    "@scalar/hono-api-reference": "^0.11.13",
    "@smithy/node-http-handler": "^4.11.3",
    "archiver": "^8.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.93",
    "hono": "^4.8.0",
    "hono-openapi": "^1.3.1",
    "ipaddr.js": "^2.5.0",
    "openapi-types": "^12.1.3",
    "resend": "^6.17.2",
    "stripe": "^22.3.1"
  }
}
